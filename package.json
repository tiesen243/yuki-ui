{
  "name": "yuki-ui",
  "private": true,
  "homepage": "https://ui.tiesen.id.vn",
  "bugs": {
    "url": "https://github.com/tiesen243/yuki-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiesen243/yuki-ui.git"
  },
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo --filter @yuki/web build",
    "clean": "turbo --filter '*' clean && git clean -xdf node_modules",
    "dev": "turbo --filter @yuki/web dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.20.0"
  },
  "catalogs": {
    "prod": {
      "@tanstack/react-query": "^5.90.12",
      "react-native-safe-area-context": "~5.10.1",
      "zod": "4.6.7"
    },
    "dev": {
      "@types/node": "^26.6.5",
      "dotenv-cli": "^11.0.0",
      "tsdown": "^0.19.0-beta.5",
      "typescript": "^7.1.0-beta"
    },
    "react": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-native": "0.88.0"
    },
    "tailwind": {
      "@tailwindcss/postcss": "^4.3.3",
      "@tailwindcss/vite": "^4.1.18",
      "tailwindcss": "^4.3.3",
      "uniwind": "^1.13.0"
    }
  }
}
